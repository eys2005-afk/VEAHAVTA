# Flask
SECRET_KEY=change-me
FLASK_ENV=development

# Google Sheets
# Either point to a local service-account JSON file...
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
# ...or paste the JSON content directly (useful on hosts like Render where
# uploading a file isn't convenient). If set, this takes priority.
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=
GOOGLE_SHEET_ID=

# Nedarim Plus (hosted payment page)
NEDARIM_MOSAD_ID=
NEDARIM_CALLBACK_URL=https://your-app.onrender.com/webhook/nedarim
# TODO: confirm the exact recurring-payment (הוראת קבע) param name/value with
# Nedarim Plus support before enabling the monthly tier.
NEDARIM_MONTHLY_RECURRING_PARAM=
