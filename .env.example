# Flask
SECRET_KEY=change-me
FLASK_ENV=development

# Google Sheets
# Either point to a local service-account JSON file...
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
# ...or paste the JSON content directly (useful on hosts like Render where
# uploading a file isn't convenient). If set, this takes priority.
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=
GOOGLE_SHEET_ID=

# Nedarim Plus (hosted payment page)
NEDARIM_MOSAD_ID=
# Required by the iframe integration ("StartPayment") - a separate
# auth token that must be requested from Nedarim Plus support, not the
# same as the Mosad ID.
NEDARIM_API_VALID=
NEDARIM_CALLBACK_URL=https://your-app.onrender.com/webhook/nedarim
NEDARIM_CALLBACK_MAIL_ERROR=
# TEMPORARY, for live-testing the payment flow cheaply: when set, every real
# charge is forced to this amount (e.g. 1) regardless of the tier's real
# price. The site still displays each tier's real price - only what's
# actually sent to Nedarim Plus is overridden. Unset once testing is done.
NEDARIM_TEST_AMOUNT=

# Displayed under the logo on the landing page. Editable weekly from
# /admin (stored in a "הגדרות" tab on the Google Sheet); the per-day/generic
# vars below are only a fallback if the sheet is unreachable.
CLASS_NAME_SUNDAY=
CLASS_NAME_MONDAY=
CLASS_NAME_TUESDAY=
CLASS_NAME_WEDNESDAY=
CLASS_NAME_THURSDAY=
CLASS_NAME_FRIDAY=
CLASS_NAME_SATURDAY=
CLASS_NAME=

# Password for /admin (weekly class schedule, free-mode toggle, workshop
# tier, registrant list). Required - admin login is disabled if left empty.
ADMIN_PASSWORD=

# Lets /admin's "about" photo gallery add/remove photos itself (gallery.py).
# A GitHub Personal Access Token (fine-grained, scoped to just this repo,
# Contents: Read and write permission only) - every upload/delete is a real
# commit to GITHUB_BRANCH via GitHub's API, which is what actually makes it
# show up on the live site once Render redeploys. Without this set, the
# gallery section in /admin shows an error instead of failing silently.
GITHUB_TOKEN=
# Only needed if this ever lives in a different repo/branch than the
# defaults in gallery.py (eys2005-afk/VEAHAVTA /
# claude/veahavta-flask-skeleton-ohzlsq).
GITHUB_REPO=
GITHUB_BRANCH=

# WhatsApp notifications to the client (Noa) on new registrations and
# successful payments (notifications.py) - via Meta's WhatsApp Cloud API
# directly. Best-effort: if any of these are missing, or the send fails,
# registration/payment still work normally - only the notification is
# skipped (logged, not raised).
# From the Meta app's WhatsApp > API Setup page.
WHATSAPP_PHONE_NUMBER_ID=
# A PERMANENT token (Business Settings > System Users > Generate New
# Token, expiration "Never", with whatsapp_business_messaging +
# whatsapp_business_management) - not the 24h temporary token the API
# Setup page's own "Generate access token" button gives.
WHATSAPP_ACCESS_TOKEN=
# The recipient (Noa), digits only with country code, e.g. 972501234567
# - no +, no whatsapp: prefix (this is Meta's own API, not Twilio's).
WHATSAPP_TO=
